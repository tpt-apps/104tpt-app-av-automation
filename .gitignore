# The desktop crate is its own workspace: its build output and the Tauri-generated
# capability schemas are reproducible and stay out of version control.
crates/tpt-app-av-automation-tauri/target/
crates/tpt-app-av-automation-tauri/gen/

/target/
**/*.rs.bk
*.pdb

# Fuzzing: libFuzzer build output, corpora and crash artifacts. Corpora are large,
# machine-specific and reproducible from the seeds, so they are not committed.
fuzz/target/
fuzz/coverage/
fuzz/corpus/
fuzz/artifacts/
fuzz/Cargo.lock

.DS_Store
Thumbs.db

*.log
*.tmp

.vscode/
.idea/
*.iml

.env
.env.local

# Runtime state
state/
*.db
*.db-wal
*.db-shm
dist/
